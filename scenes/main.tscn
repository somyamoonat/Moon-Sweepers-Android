corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main")

[node name="SpaceBackground" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.0470588, 0.054902, 0.0901961, 1)

[node name="LunarSurface" parent="." instance=ExtResource("2_surface")]
layout_mode = 1
offset_top = -410.0
offset_bottom = 490.0

[node name="HUD" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="TopBar" type="VBoxContainer" parent="HUD"]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_left = 60.0
offset_top = 70.0
offset_right = -60.0
offset_bottom = 320.0
grow_horizontal = 2
mouse_filter = 2
theme_override_constants/separation = 14

[node name="TitleLabel" type="Label" parent="HUD/TopBar"]
layout_mode = 2
theme_override_font_sizes/font_size = 54
text = "MOON SWEEPERS"
horizontal_alignment = 1

[node name="SubTitleLabel" type="Label" parent="HUD/TopBar"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65098, 0.690196, 0.780392, 1)
theme_override_font_sizes/font_size = 28
text = "Sector 01: Mare Tranquillitatis"
horizontal_alignment = 1

[node name="CleanPercentageLabel" type="Label" parent="HUD/TopBar"]
layout_mode = 2
theme_override_colors/font_color = Color(0.407843, 0.811765, 1, 1)
theme_override_font_sizes/font_size = 46
text = "Clean:  0.0%"
horizontal_alignment = 1

[node name="ProgressBar" type="ProgressBar" parent="HUD/TopBar"]
custom_minimum_size = Vector2(0, 32)
layout_mode = 2
mouse_filter = 2
show_percentage = false

[node name="Controls" type="VBoxContainer" parent="HUD"]
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 60.0
offset_top = -340.0
offset_right = -60.0
offset_bottom = -60.0
grow_horizontal = 2
grow_vertical = 0
mouse_filter = 2
theme_override_constants/separation = 20

[node name="BrushControls" type="HBoxContainer" parent="HUD/Controls"]
layout_mode = 2
theme_override_constants/separation = 24
alignment = 1

[node name="BrushSmallerBtn" type="Button" parent="HUD/Controls/BrushControls"]
custom_minimum_size = Vector2(100, 70)
layout_mode = 2
theme_override_font_sizes/font_size = 36
theme_override_styles/hover = SubResource("StyleBoxFlat_btn_hover")
theme_override_styles/normal = SubResource("StyleBoxFlat_button")
text = "-"

[node name="BrushSizeLabel" type="Label" parent="HUD/Controls/BrushControls"]
custom_minimum_size = Vector2(360, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Brush Size: 48 px"
horizontal_alignment = 1
vertical_alignment = 1

[node name="BrushLargerBtn" type="Button" parent="HUD/Controls/BrushControls"]
custom_minimum_size = Vector2(100, 70)
layout_mode = 2
theme_override_font_sizes/font_size = 36
theme_override_styles/hover = SubResource("StyleBoxFlat_btn_hover")
theme_override_styles/normal = SubResource("StyleBoxFlat_button")
text = "+"

[node name="ResetButton" type="Button" parent="HUD/Controls"]
custom_minimum_size = Vector2(0, 74)
layout_mode = 2
theme_override_font_sizes/font_size = 30
theme_override_styles/hover = SubResource("StyleBoxFlat_btn_hover")
theme_override_styles/normal = SubResource("StyleBoxFlat_button")
text = "Reset Sector Dust"

[node name="CompletionBanner" type="Panel" parent="HUD"]
visible = false
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -340.0
offset_top = -90.0
offset_right = 340.0
offset_bottom = 90.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_banner")

[node name="Label" type="Label" parent="HUD/CompletionBanner"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_font_sizes/font_size = 38
text = "★ SECTION COMPLETE! ★
Sector Cleaned!"
horizontal_alignment = 1
vertical_alignment = 1

[connection signal="pressed" from="HUD/Controls/BrushControls/BrushSmallerBtn" to="." method="_on_brush_smaller_pressed"]
[connection signal="pressed" from="HUD/Controls/BrushControls/BrushLargerBtn" to="." method="_on_brush_larger_pressed"]
[connection signal="pressed" from="HUD/Controls/ResetButton" to="." method="_on_reset_button_pressed"]
