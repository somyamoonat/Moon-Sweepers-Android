theme_override_colors/font_color = Color(0.8, 0.85, 0.94, 1)
theme_override_font_sizes/font_size = 28
text = "1. DRAG TO SCRUB:
Swipe your finger or mouse across the dirty lunar regolith to scrub dust into your hopper.

2. STORAGE LIMIT:
Your tank fills with dust. When full, tap the big SELL DUST button to convert it into Credits.

3. AUTOMATION & UPGRADES:
Open the Shop to unlock wider brushes, larger tanks, autonomous Cleaning Bots, and the Auto-Sell Module.

4. SECTOR PROGRESSION:
Clean 95% of a sector to receive a large credit bonus and advance to new, dustier sectors!"
autowrap_mode = 2

