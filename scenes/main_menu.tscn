[node name="Content" type="Label" parent="HowToPlayPanel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.94, 1)
theme_override_font_sizes/font_size = 24
text = "• MOVEMENT: Left thumb Virtual Joystick (or WASD / Arrow keys on desktop).
• CAMERA: Touch-drag anywhere on the right screen half (or Right-Click Drag).
• SWEEPING: Toggle 🧹 SWEEP: ON to lower your broom and sweep 3D regolith.
• ANGLE LOCK (L-LOCK): Toggle 🔒 L-LOCK to lock camera heading and sweep parallel stripes!
• JETPACK: Hold 🚀 JETPACK (or Spacebar) to ignite low-gravity thrusters.
• PHYSICAL CAPSULES: Tap 📦 PACK CAPSULE to compress 10 kg into a physics capsule item.
• SELLING: Deliver physical capsules into the Depot's holo-funnel, or dock on the pad to sell!"
autowrap_mode = 2

